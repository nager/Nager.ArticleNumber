<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>Tino Hager</Authors>
    <Company>nager.at</Company>
    <Description>Validate article numbers (EAN8, EAN13, GTIN, ISBN10, ISBN13, ISSN, UPC, ASIN). Detect the article number type of a code</Description>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <LangVersion>12.0</LangVersion>
    <IncludeSymbols>true</IncludeSymbols>
    
    <Nullable>enable</Nullable>
    
    <!--<PackageIcon>logo.png</PackageIcon>-->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--<PackageReleaseNotes>A changelog is available at https://github.com/nager/Nager.ArticleNumber/releases</PackageReleaseNotes>-->
    <PackageProjectUrl>https://github.com/nager/Nager.ArticleNumber</PackageProjectUrl>
    <PackageTags>ArticleNumber;EAN8;EAN13;GTIN;ISBN10;ISBN13;ISSN;UPC;ASIN</PackageTags>
    
    <RepositoryUrl>https://github.com/nager/Nager.ArticleNumber</RepositoryUrl>
    
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    
    <Version>1.0.8</Version>
  </PropertyGroup>
 
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="..\..\doc\README.md" Pack="true" PackagePath="" />
  </ItemGroup>  

</Project>
